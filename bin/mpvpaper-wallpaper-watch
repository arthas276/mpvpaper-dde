#!/bin/bash
# mpvpaper 官方壁纸接管钩子（watch）
# 监听会话总线 org.deepin.dde.Appearance1.Changed：
#   官方壁纸值 = 视频  → 写入 conf 并拉起/热切 mpvpaper 接管播放
#   官方壁纸值 = 静态图 → 停壁纸栈让出桌面（dde-shell 画布显示静态壁纸）
# 独立常驻（mpvpaper-wallpaper-watch.service），不依赖壁纸栈存活。
set -u

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/mpvpaper-wallpaper.conf"
SVC=mpvpaper-wallpaper.service
CANVAS=dde-shell-plugin@org.deepin.ds.desktop.service
MPV_SOCK="$XDG_RUNTIME_DIR/mpvpaper-wallpaper.sock"
APPEAR=org.deepin.dde.Appearance1
APPATH=/org/deepin/dde/Appearance1
SMNAME=com.deepin.SessionManager
SMPATH=/com/deepin/SessionManager
STATE="$XDG_RUNTIME_DIR/mpvpaper-watch.state"
WANT="$XDG_RUNTIME_DIR/mpvpaper-watch.want"   # playing=接管中 / yield=让位中
# 最近一次静态官方壁纸值（持久）：接管视频后回写它当占位，保锁屏。
# 锁屏渲染器加载不了 mp4 的 wallpaper 值（黑屏），动态源另在别处。
STATIC_MEM="$HOME/.local/state/mpvpaper-wallpaper/static-uri"
DEFAULT_STATIC="file:///usr/share/wallpapers/deepin/organic-glass-dark.jpg"

log() { echo "[mpvpaper-watch] $*"; }

locked_now() {
  # 锁态权威源：SessionManager.Locked 属性。V25/Treeland 下 login1 LockedHint
  # 任何锁型都不置位（2026-10-15 实测：手动锁属性=true 而 hint=no，旧对账
  # 据 hint 误判解锁态、锁屏下复活引擎空转 40% CPU）。属性不可得才退 hint。
  local v sid
  v=$(busctl --user get-property "$SMNAME" "$SMPATH" "$SMNAME" Locked 2>/dev/null)
  case "$v" in
    *true*)  return 0 ;;
    *false*) return 1 ;;
  esac
  sid="${XDG_SESSION_ID:-$(loginctl list-sessions --no-legend 2>/dev/null | awk -v u="$(id -un)" '$3==u{print $1; exit}')}"
  [ "$(loginctl show-session "$sid" -p LockedHint --value 2>/dev/null)" = yes ]
}

official_uri() {
  busctl --user call "$APPEAR" "$APPATH" "$APPEAR" GetCurrentWorkspaceBackground 2>/dev/null |
    grep -oP '(?<=")file://[^"]+' | head -1
}

uri_to_path() {
  printf '%s' "${1#file://}" | sed 's/%20/ /g; s/%3A/:/g'
}

is_video() {
  case "${1,,}" in *.mp4|*.webm|*.mkv|*.mov|*.gif) return 0 ;; *) return 1 ;; esac
}

cur_video() { bash -c ". '$CONF' 2>/dev/null; echo \"\$VIDEO\""; }

mpv_ipc() { printf '%s\n' "$1" | timeout 2 socat - "$MPV_SOCK" >/dev/null 2>&1 || true; }

start_stack() {
  # 拉起壁纸栈；仅真实完成 inactive→active 转换时才抬画布。
  # Treeland layer-shell 同层按映射先后叠放：mpvpaper 重映射晚于画布
  # → 视频盖住桌面图标。已活跃时 start 为 no-op、不抬（loadfile 热切
  # 不重映射、无需抬）。三路解锁信号并发时，首路完成转换后其余路
  # was_active=1，天然去重。
  local was_active=0
  systemctl --user is-active --quiet "$SVC" && was_active=1
  [ "$was_active" = 0 ] && rm -f "$MPV_SOCK" 2>/dev/null   # 清残留 socket，让抬画布的等待真实反映本次引擎启动
  systemctl --user reset-failed "$SVC" 2>/dev/null
  systemctl --user start "$SVC" 2>/dev/null || return 1
  [ "$was_active" = 0 ] && bump_canvas
  return 0
}

bump_canvas() {
  # 抬画布=重启 dde-shell 桌面画布单元：画布重映射必在刚映射的
  # mpvpaper 之上，图标回到视频上方（2026-10-15 实测配方）。
  # 等 mpv IPC socket 出现+0.4s 再动（引擎真起来了）；引擎没起来
  # 不抬（没有东西盖图标）。20s 防抖挡并发重复抬。
  local guard="$XDG_RUNTIME_DIR/mpvpaper-canvas-bump.time" now last i=0
  now=$(date +%s); last=$(cat "$guard" 2>/dev/null) || last=0
  [ $((now - last)) -ge 20 ] || return 0
  printf '%s' "$now" > "$guard"
  while [ $i -lt 75 ] && [ ! -S "$MPV_SOCK" ]; do sleep 0.2; i=$((i+1)); done
  [ -S "$MPV_SOCK" ] || { log "不抬画布：mpv socket 未出现（引擎未起来）"; return 0; }
  sleep 0.4
  systemctl --user reset-failed "$CANVAS" 2>/dev/null
  if systemctl --user restart "$CANVAS" 2>/dev/null; then
    log "拉回完成 → 抬画布（图标回视频上方）"
  else
    log "画布重启失败（不影响壁纸播放）"
  fi
}

set_conf_video() {
  local tmp
  tmp=$(mktemp) || return 1
  {
    [ -r "$CONF" ] && grep -v '^VIDEO=' "$CONF"
    printf 'VIDEO="%s"\n' "$1"
  } > "$tmp" 2>/dev/null && mv "$tmp" "$CONF"
}

read_static_mem() { [ -r "$STATIC_MEM" ] && cat "$STATIC_MEM"; }
save_static_mem() {
  mkdir -p "$(dirname "$STATIC_MEM")" 2>/dev/null
  printf '%s' "$1" > "$STATIC_MEM"
}
set_official_wallpaper() {
  busctl --user call "$APPEAR" "$APPATH" "$APPEAR" Set ss wallpaper "$1" >/dev/null 2>&1
}

apply_official() {
  local uri path cur exempt
  uri=$(official_uri)
  [ -n "$uri" ] || return 0
  exempt=$(read_static_mem)
  # 豁免前置（先于去重）：占位静态值=接管态，补写 want 后直接返回。
  # 注：用户真选了同一张占位图会被误豁免（已知 edge case，接受）。
  if [ -n "$exempt" ] && [ "$uri" = "$exempt" ]; then
    printf playing > "$WANT"
    return 0
  fi
  [ "$(cat "$STATE" 2>/dev/null)" = "$uri" ] && return 0
  printf '%s' "$uri" > "$STATE"
  exempt=$(read_static_mem)
  path=$(uri_to_path "$uri")

  if is_video "$path" && [ -f "$path" ]; then
    cur=$(cur_video)
    set_conf_video "$path"
    if systemctl --user is-active --quiet "$SVC"; then
      [ "$cur" = "$path" ] || mpv_ipc "loadfile \"$path\""
    else
      start_stack
    fi
    # 回写静态占位：锁屏不能接受 mp4 的 wallpaper 值。回写触发的 Changed
    # 会命中去重（STATE 已提前写成 exempt）或豁免分支，不打断播放。
    [ -n "$exempt" ] || { exempt=$DEFAULT_STATIC; save_static_mem "$exempt"; }
    if [ "$exempt" != "$uri" ]; then
      set_official_wallpaper "$exempt"
      printf '%s' "$exempt" > "$STATE"
    fi
    printf playing > "$WANT"
    log "接管视频壁纸: $path（官方值回写静态占位保锁屏）"
  elif is_video "$path"; then
    log "官方值是视频但文件不存在: $path"
  elif [ -n "$exempt" ] && [ "$uri" = "$exempt" ]; then
    printf playing > "$WANT"
    return 0   # 我们回写的占位，继续播，不动栈
  else
    save_static_mem "$uri"
    printf yield > "$WANT"
    if systemctl --user is-active --quiet "$SVC"; then
      systemctl --user stop "$SVC"
      log "官方壁纸为静态图，让出桌面"
    fi
  fi
}

monitor_lock() {
  # 锁屏 → 停壁纸栈（mpv 静帧 surface 会盖住锁屏自身的动态背景）；
  # 解锁 → 仅在接管态（want=playing）拉回，不破坏让位。
  while :; do
    dbus-monitor --session "type='signal',interface=com.deepin.SessionManager,member=LockedChanged" 2>/dev/null |
    while read -r line; do
      case "$line" in
        *member=LockedChanged*) pending=1 ;;
        *boolean*)
          [ "${pending:-0}" = 1 ] || continue
          pending=0
          case "$line" in
            *true*)
              systemctl --user stop "$SVC" 2>/dev/null
              log "锁屏 → 停壁纸栈（让位锁屏动态背景）" ;;
            *false*)
              [ "$(cat "$WANT" 2>/dev/null)" = playing ] || { log "解锁（dde）但 want 非 playing，不拉回"; continue; }
              start_stack
              log "解锁（dde）→ 拉回壁纸栈" ;;
          esac ;;
      esac
    done
    sleep 5
  done
}

monitor_login1() {
  # logind 兜底：输密码真实解锁未必走 dde 信号链，login1 的 Lock/Unlock 必发。
  while :; do
    dbus-monitor --system "type='signal',interface='org.freedesktop.login1.Session'" 2>/dev/null |
    while read -r line; do
      case "$line" in
        *member=Unlock*)
          [ "$(cat "$WANT" 2>/dev/null)" = playing ] || { log "解锁（login1）但 want 非 playing，不拉回"; continue; }
          start_stack
          log "解锁（login1）→ 拉回壁纸栈" ;;
        *member=Lock*)
          systemctl --user stop "$SVC" 2>/dev/null
          log "锁屏（login1）→ 停壁纸栈" ;;
      esac
    done
    sleep 5
  done
}

monitor_locked_prop() {
  # 第三路：PropertiesChanged(.Locked)。treeland idle 自动锁对 dde/login1
  # 双路零信号（2026-10-14 实测）；dde 手动锁实测属性必翻（2026-10-15）。
  # idle 锁若也翻属性即被此路捕获（观测站验证中）。
  while :; do
    dbus-monitor --session "type='signal',interface='org.freedesktop.DBus.Properties',member='PropertiesChanged',arg0='com.deepin.SessionManager'" 2>/dev/null |
    while read -r line; do
      case "$line" in
        *"Locked"*) pending=1 ;;
        *boolean*)
          [ "${pending:-0}" = 1 ] || continue
          pending=0
          case "$line" in
            *true*)
              systemctl --user stop "$SVC" 2>/dev/null
              log "锁屏（属性 .Locked→true）→ 停壁纸栈" ;;
            *false*)
              [ "$(cat "$WANT" 2>/dev/null)" = playing ] || { log "解锁（属性翻转）但 want 非 playing，不拉回"; continue; }
              start_stack
              log "解锁（属性 .Locked→false）→ 拉回壁纸栈" ;;
          esac ;;
      esac
    done
    sleep 5
  done
}

reconcile() {
  # 对账兜底：锁屏监听实测丢过事件（2026-10-14/15），每 20s 按锁态+want
  # 收敛：want=playing 且未锁 → 栈应活跃；已锁 → 应停。
  # 锁态判定走 locked_now()：Locked 属性优先（hint 在 V25 从不置位）。
  while :; do
    if [ "$(cat "$WANT" 2>/dev/null)" = playing ]; then
      if locked_now; then
        systemctl --user is-active --quiet "$SVC" && {
          systemctl --user stop "$SVC" 2>/dev/null
          log "对账: 锁屏态停栈（Locked=true）"
        }
      else
        systemctl --user is-active --quiet "$SVC" || {
          start_stack
          log "对账: 解锁态拉回壁纸栈"
        }
      fi
    fi
    sleep 20
  done
}

monitor_lock &
monitor_login1 &
monitor_locked_prop &
reconcile &

apply_official   # 启动时对齐一次当前官方值
while :; do
  dbus-monitor --session "type='signal',interface=$APPEAR,member=Changed" 2>/dev/null |
  while read -r line; do
    case "$line" in *member=Changed*) apply_official ;; esac
  done
  sleep 5
done
